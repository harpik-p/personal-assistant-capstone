# Demo mode needs no credentials.
ASSISTANT_DB_PATH=assistant.db
ASSISTANT_AUTO_ACTION_THRESHOLD=0.85
ASSISTANT_CONFIRM_THRESHOLD=0.55
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
ASSISTANT_CALENDAR_SOURCE=demo
ASSISTANT_REASONING_MODE=rules
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMAIL_TIMEOUT=45
ASSISTANT_MEMORY_MODE=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_TIMEOUT=20
GMAIL_PROCESS_LIMIT=5
